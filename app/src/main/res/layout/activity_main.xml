<?xml version="1.0" encoding="utf-8"?>
<!-- מסך הבית החדש (סעיף א' בבקשת השיפור): רק כפתור עגול גדול במרכז המסך
     להפעלה/כיבוי ההאזנה, וכפתור "הגדרות" צמוד לתחתית שפותח את SettingsActivity
     (שם עברו כל שדות הקלט - מספרי טלפון, מענה אוטומטי, רגישות, ערכת נושא).
     צבעים דרך "?attr/..." כדי לתמוך בשלוש ערכות הנושא (מערכת/בהיר/כהה) -
     ראו attrs.xml/styles.xml/ThemeUtil.java. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBgMain">

    <!-- רצועת כותרת עליונה: אקסנט טורקיז, בדיוק כמו באפליקציה שנבדקה -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="?attr/colorHeaderBg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorAccent"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/app_name" />
    </LinearLayout>

    <!-- כפתור "הגדרות" - צמוד לתחתית המסך, כפי שנתבקש -->
    <Button
        android:id="@+id/settingsButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:background="@drawable/bg_contact_button"
        android:textColor="@color/text_white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:nextFocusUp="@id/startStopButton"
        android:text="@string/settings_button" />

    <!-- כפתור ההפעלה/כיבוי המרכזי הגדול, ממורכז אנכית ואופקית במסך -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="28dp"
            android:text="@string/status_idle" />

        <Button
            android:id="@+id/startStopButton"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:background="@drawable/bg_toggle_idle"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="20sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:nextFocusDown="@id/settingsButton"
            android:text="@string/start_listening_short" />

    </LinearLayout>

</RelativeLayout>
