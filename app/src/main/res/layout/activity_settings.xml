<?xml version="1.0" encoding="utf-8"?>
<!-- מסך ההגדרות (סעיף א'): כל שדות הקלט שהיו בעבר במסך הבית - מספרי טלפון,
     מענה אוטומטי (כולל האפשרות לאפשר אותו גם בלי האזנה פעילה - סעיף ב'),
     הגדרות שמע, רגישות, ובנוסף בחירת ערכת נושא (סעיף ד'). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBgMain">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorHeaderBg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorAccent"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/settings_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="16sp"
                android:text="@string/phone_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/phoneNumberInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:textColor="?attr/colorTextPrimary"
                    android:textColorHint="?attr/colorTextSecondary"
                    android:background="?attr/colorRowBg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="18sp"
                    android:inputType="phone"
                    android:nextFocusDown="@id/phoneContactButton"
                    android:hint="0501234567" />

                <Button
                    android:id="@+id/phoneContactButton"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/bg_contact_button"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:nextFocusDown="@id/secondaryPhoneNumberInput"
                    android:text="@string/pick_contact" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="16sp"
                android:paddingTop="16dp"
                android:text="@string/phone_secondary_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/secondaryPhoneNumberInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:textColor="?attr/colorTextPrimary"
                    android:textColorHint="?attr/colorTextSecondary"
                    android:background="?attr/colorRowBg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="18sp"
                    android:inputType="phone"
                    android:nextFocusDown="@id/secondaryContactButton"
                    android:hint="0521234567 (רשות)" />

                <Button
                    android:id="@+id/secondaryContactButton"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/bg_contact_button"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:nextFocusDown="@id/autoAnswerEnabledCheck"
                    android:text="@string/pick_contact" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="20dp"
                android:background="?attr/colorDivider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorAccent"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="20dp"
                android:paddingBottom="4dp"
                android:text="@string/auto_answer_section_title" />

            <!-- הבהרה (סעיף ב'): מענה אוטומטי לשיחה נכנסת עובד גם כשההאזנה
                 לבכי כבויה - זה שני מנגנונים נפרדים לגמרי כעת. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="13sp"
                android:paddingBottom="8dp"
                android:text="@string/auto_answer_independent_note" />

            <CheckBox
                android:id="@+id/autoAnswerEnabledCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="15sp"
                android:nextFocusDown="@id/autoAnswerNumbersInput"
                android:text="@string/auto_answer_enabled" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="14sp"
                android:paddingTop="10dp"
                android:text="@string/auto_answer_numbers_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/autoAnswerNumbersInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:textColor="?attr/colorTextPrimary"
                    android:textColorHint="?attr/colorTextSecondary"
                    android:background="?attr/colorRowBg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="16sp"
                    android:inputType="phone"
                    android:nextFocusDown="@id/autoAnswerContactButton"
                    android:hint="0501234567,0521234567" />

                <Button
                    android:id="@+id/autoAnswerContactButton"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/bg_contact_button"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:nextFocusDown="@id/autoAnswerSpeakerCheck"
                    android:text="@string/pick_contact" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/autoAnswerSpeakerCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="15sp"
                android:nextFocusDown="@id/allCallsSpeakerCheck"
                android:text="@string/auto_answer_speaker" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="20dp"
                android:background="?attr/colorDivider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorAccent"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:text="@string/audio_section_title" />

            <CheckBox
                android:id="@+id/allCallsSpeakerCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="15sp"
                android:nextFocusDown="@id/muteIncomingVoiceCheck"
                android:text="@string/all_calls_speaker" />

            <CheckBox
                android:id="@+id/muteIncomingVoiceCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="15sp"
                android:nextFocusDown="@id/muteRingerWhileActiveCheck"
                android:text="@string/mute_incoming_voice" />

            <CheckBox
                android:id="@+id/muteRingerWhileActiveCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="15sp"
                android:nextFocusDown="@id/sensitivityGroup"
                android:text="@string/mute_ringer_while_active" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="20dp"
                android:background="?attr/colorDivider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="16sp"
                android:paddingTop="20dp"
                android:text="@string/sensitivity_label" />

            <RadioGroup
                android:id="@+id/sensitivityGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:nextFocusDown="@id/themeGroup">

                <RadioButton
                    android:id="@+id/sensitivityHigh"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="16sp"
                    android:text="@string/sensitivity_high" />

                <RadioButton
                    android:id="@+id/sensitivityMedium"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="16sp"
                    android:checked="true"
                    android:text="@string/sensitivity_medium" />

                <RadioButton
                    android:id="@+id/sensitivityLow"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="16sp"
                    android:text="@string/sensitivity_low" />

            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="20dp"
                android:background="?attr/colorDivider" />

            <!-- בחירת ערכת נושא (סעיף ד'): מערכת/בהיר/כהה, ברירת המחדל
                 "מערכת" (RadioButton הראשון מסומן כברירת מחדל). -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="16sp"
                android:paddingTop="20dp"
                android:text="@string/theme_label" />

            <RadioGroup
                android:id="@+id/themeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:nextFocusDown="@id/saveButton">

                <RadioButton
                    android:id="@+id/themeSystem"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="16sp"
                    android:checked="true"
                    android:text="@string/theme_system" />

                <RadioButton
                    android:id="@+id/themeLight"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="16sp"
                    android:text="@string/theme_light" />

                <RadioButton
                    android:id="@+id/themeDark"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="16sp"
                    android:text="@string/theme_dark" />

            </RadioGroup>

            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="?attr/colorAccent"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                android:textSize="18sp"
                android:text="@string/save_settings" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
