<?xml version="1.0" encoding="utf-8"?>
<!-- אייקון אדפטיבי (Adaptive Icon) - נלקח בחשבון רק במכשירים עם אנדרואיד 8+
     שתומכים בפורמט הזה, ללא קשר ל-targetSdk של האפליקציה עצמה. במכשירי
     היעד (שיאומי מקשים עם אנדרואיד ישן) קובץ זה פשוט לא נטען כלל, וה-PNG-ים
     הרגילים בתיקיות mipmap-*dpi (ic_launcher.png / ic_launcher_round.png)
     משמשים כרגיל. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
