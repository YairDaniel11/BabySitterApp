<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- פלטת הצבעים הזו מבוססת על מה שנמצא בפועל באפליקציה אמיתית שרצה על
         מכשיר שיאומי מקשים: רקע כהה, header שחור עם רצועת אקסנט טורקיז,
         טקסט לבן/אפור בהיר. עיצוב שטוח לגמרי, בלי צללים/גרדיאנטים. -->
    <color name="bg_dark">#FF2B2E33</color>
    <color name="header_black">#FF000000</color>
    <color name="accent_teal">#FF00BCD4</color>
    <color name="text_white">#FFFFFFFF</color>
    <color name="text_light_gray">#FFCCCCCC</color>
    <color name="divider_gray">#FF444444</color>
    <color name="row_gray">#FF3A3E44</color>

    <!-- הצ'קבוקסים במסך לא מוגדרים עם צבע מותאם אישית - הם משתמשים ב-tint
         ברירת המחדל של הפלטפורמה (הוי הירוק הסטנדרטי של אנדרואיד ל-CheckBox/
         RadioButton מסומן). הפניה לאותו צבע פלטפורמה בדיוק, כדי שמסגרת
         הפוקוס תתאים בול לצבע ה-V הירוק שרואים בסימון תיבות הסימון. אם בפועל
         במכשיר היעד (שיאומי מקשים) ה-tint נראה מעט שונה בגלל עיצוב יצרן
         משלו - פשוט שנו כאן לצבע ה-HEX המדויק שנצפה שם. -->
    <color name="focus_green">@android:color/holo_green_light</color>
</resources>
